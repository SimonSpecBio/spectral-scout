# Same shared Postgres instance as spectral-ops/spectral-pilot/spectral-rnd
# (see drizzle.config.ts / db/index.ts for why that's safe -- dedicated
# table prefixes + a dedicated migrations tracking table).
DATABASE_URL=

# Random signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Internal Spectral staff allowlist, comma separated.
ALLOWED_STAFF_EMAILS=

# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Needs its OWN client
# (not reused from spectral-ops/spectral-pilot/spectral-rnd -- each app has
# a distinct one, matched by redirect URI):
#   <your-deployment-url>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Grower magic-link sign-in (Resend SMTP, or any SMTP provider). Growers are
# arbitrary external emails, so this needs a verified sending domain, not
# Resend's sandbox mode (sandbox only delivers to the account owner) --
# see spectral-pilot's README for the same issue and the fix.
EMAIL_SERVER=
EMAIL_FROM=

# Photo uploads (facility map background images, scouting/pest-event
# photos). vercel.com/dashboard -> Storage -> Blob -> Create.
BLOB_READ_WRITE_TOKEN=

# Shared secret the four /api/cron/* routes require on their Authorization
# header -- without it, every scheduled job fails closed (401) with no
# visible symptom other than alerts/nudges silently never firing. Any
# random string; must match what's configured on the Vercel Cron Jobs
# themselves. node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Self-hosted Web Push (lib/push.ts) -- generate with:
#   npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY must be the same value as VAPID_PUBLIC_KEY
# (one is read server-side to sign pushes, the other is exposed to the
# browser so it can subscribe) -- keep them in sync by hand.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Error tracking (Phase 0.2b, build-cycle doc 2026-09-07). Sentry project
# settings -> Client Keys (DSN). Same value in both -- one is read
# server/edge-side (instrumentation.ts), the other client-side
# (instrumentation-client.ts). Not secret; safe to see in a client bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
