# Same shared Postgres instance as spectral-ops/spectral-pilot/spectral-rnd
# (see drizzle.config.ts / db/index.ts for why that's safe -- dedicated
# table prefixes + a dedicated migrations tracking table).
DATABASE_URL=

# Random signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Internal Spectral staff allowlist, comma separated.
ALLOWED_STAFF_EMAILS=

# console.cloud.google.com -> APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application. Needs its OWN client
# (not reused from spectral-ops/spectral-pilot/spectral-rnd -- each app has
# a distinct one, matched by redirect URI):
#   <your-deployment-url>/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google (local dev)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Grower magic-link sign-in (Resend SMTP, or any SMTP provider). Growers are
# arbitrary external emails, so this needs a verified sending domain, not
# Resend's sandbox mode (sandbox only delivers to the account owner) --
# see spectral-pilot's README for the same issue and the fix.
EMAIL_SERVER=
EMAIL_FROM=

# Photo uploads (facility map background images, scouting/pest-event
# photos). vercel.com/dashboard -> Storage -> Blob -> Create.
BLOB_READ_WRITE_TOKEN=
